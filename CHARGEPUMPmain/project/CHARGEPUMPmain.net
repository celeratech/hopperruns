*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map SIMPV 21
.node_map OUT 22
.node_map PGND 23
.node_map HV 28
.node_map enable_chargepump 27
.node_map CLOW 24
.node_map clock_chargepump 25
.node_map CHIGH 26
.node_map GND 29
.options
+ PSP_NPT=10001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ POP_SHOWDATA
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
*.pop TRIG_GATE={{TRIG_GATE}} TRIG_COND=0_TO_1 MAX_PERIOD=1u CONVERGENCE=1p CYCLES_BEFORE_LAUNCH=5 TD_RUN_AFTER_POP_FAILS=-1
.tran 300u 0
.globalvar REF=1.0
.globalvar VIN=5
.globalvar tdext_khz=1000

X$CHARGEPUMPmain 21 22 23 24 25 26 27 28 20 0 CHARGEPUMPmain

X$U1 0 celera vars: simulation_module='name' status='dev' simulation='typical'
