* Z:\celera\projects\Simplis\playcalum\Puget\Puget0\301\overlay\overlay_CAPbalancer.sxsch
*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map SIMPV 24
.node_map CAPRTN 29
.node_map enable_shunt 30
.node_map maximum_channel$0 22
.node_map maximum_channel$1 21
.node_map clock 31
.node_map CAP1 28
.node_map CAP2 27
.node_map CAP3 26
.node_map CAP4 25
.node_map IN 23
.options
+ PSP_NPT=50001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 1m 0

.globalvar TEMP=25
.globalvar tdext_khz=10

.globalvar IN = 12
.globalvar VIN = 5.0
.globalvar REF = 1.2
.globalvar VCC2P5=2.4

.globalvar CAP1=2.0
.globalvar CAP2=2.0
.globalvar CAP3=2.0
.globalvar CAP4=2.0

X$BALANCER 23 24 25 26 27 28 29 31 30 22 21 20 CAPbalancer
.PRINT V(#IN)
.GRAPH :#IN curveLabel= IN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe1  
.GRAPH "ComposeDigital('#maximum_channel', [0, 1],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=bin curveLabel="maximum_channel" disabled=false 
.PRINT ^maximum_channel$*
.PRINT V(#SIMPV)
.GRAPH :#SIMPV curveLabel= SIMPV nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe2  
.PRINT V(#CAP4)
.GRAPH :#CAP4 curveLabel= CAP4 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe3  
.PRINT V(#CAP3)
.GRAPH :#CAP3 curveLabel= CAP3 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe4  
.PRINT V(#CAP2)
.GRAPH :#CAP2 curveLabel= CAP2 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe5  
.PRINT V(#CAP1)
.GRAPH :#CAP1 curveLabel= CAP1 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe6  
.PRINT V(#CAPRTN)
.GRAPH :#CAPRTN curveLabel= cAPRTN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe7  
.PRINT V(#enable_shunt)
.GRAPH :#enable_shunt curveLabel= enable_shunt nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe8  
.PRINT V(#clock)
.GRAPH :#clock curveLabel= clock nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe9  
X$U1 0 celera vars: simulation_module='name' status='dev' simulation='typical'
