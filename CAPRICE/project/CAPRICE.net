* Z:\celera\projects\Simplis\playrelease\Release\play301\Caprice\300\verification\sim_CAPRICE.sxsch
*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map SNS 9
.node_map BIAS 12
.node_map PGND 13
.node_map VCC 10
.node_map DRN 11
.node_map GATE 14
.node_map GND 15
.options
+ PSP_NPT=50001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 2m 0

.globalvar TEMP=25
*celera
.globalvar VIN = 5.0
.globalvar REF = 1.0
.globalvar tdext_khz=10

*Externals
.globalvar Cvcc=0.1u
.globalvar Cvcc_initial=0
.globalvar Cbias=1u
.globalvar Cbias_initial=0
.globalvar Rdrn_pullup=100K

*Force
.globalvar Fsns=10k
.globalvar Tsns_start=200u


X$CAPRICE 10 9 12 11 14 15 13 CAPRICE
X$U1 0 celera vars: simulation_module='name' status='dev' simulation='typical'
