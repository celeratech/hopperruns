* Z:\celera\projects\Simplis\playcalum\Puget\Puget0\301\overlay\overlay_CAPmeasure.sxsch
*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map shunt_registeractive 38
.node_map SIMPV 30
.node_map CAPmeasureDIFF 28
.node_map CAPRTN 35
.node_map done_capmeasure 29
.node_map clock 37
.node_map measure_cap$0 26
.node_map measure_cap$1 27
.node_map CAP1 34
.node_map CAP2 33
.node_map CAP3 32
.node_map CAP4 31
.node_map GND 39
.node_map enable_capmeasure 36
.options
+ PSP_NPT=50001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 325u 0

.globalvar TEMP=25
.globalvar tdext_khz=10

.globalvar IN = 12
.globalvar VIN = 5.0
.globalvar REF = 1.2
.globalvar VCC2P5=2.4

.globalvar CAP1=2.0
.globalvar CAP2=2.2
.globalvar CAP3=2.4
.globalvar CAP4=2.6

X$MEAUSRE 30 28 29 31 32 33 34 35 36 37 26 27 39 38 CAPmeasure
.PRINT V(#CAP4)
.GRAPH :#CAP4 curveLabel= CAP4 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe1  
.PRINT V(#shunt_registeractive)
.GRAPH :#shunt_registeractive curveLabel= shunt_registeractive nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe10  
.PRINT V(#GND)
.GRAPH :#GND curveLabel= GND nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe11  
.GRAPH "ComposeDigital('#measure_cap', [0, 1],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=dec curveLabel="measure_cap" disabled=false 
.PRINT ^measure_cap$*
.PRINT V(#CAP3)
.GRAPH :#CAP3 curveLabel= CAP3 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe2  
.PRINT V(#CAP2)
.GRAPH :#CAP2 curveLabel= CAP2 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe3  
.PRINT V(#CAP1)
.GRAPH :#CAP1 curveLabel= CAP1 nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe4  
.PRINT V(#CAPmeasureDIFF)
.GRAPH :#CAPmeasureDIFF curveLabel= CAPmeasureDIFF nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe5  
.PRINT V(#done_capmeasure)
.GRAPH :#done_capmeasure curveLabel= done_capmeasure nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe6  
.PRINT V(#CAPRTN)
.GRAPH :#CAPRTN curveLabel= CAPRTN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe7  
.PRINT V(#enable_capmeasure)
.GRAPH :#enable_capmeasure curveLabel= enable_capmeasure nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe8  
.PRINT V(#clock)
.GRAPH :#clock curveLabel= clock nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe9  
X$U1 0 celera vars: simulation_module='name' status='dev' simulation='typical'
