.GRAPH :#SYNC curveLabel= SYNC nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe6  
.PRINT V(#PGND)
.GRAPH :#PGND curveLabel= PGND nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe7  
.PRINT V(#SW)
.GRAPH :#SW curveLabel= SW nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe8  
.PRINT V(#BST)
.GRAPH :#BST curveLabel= BST nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe9  
