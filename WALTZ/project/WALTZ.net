* Z:\celera\projects\Simplis\playkristan\WALTZ\WALTZ\301c\verification\sim_WALTZ.sxsch
*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map BST 42
.node_map FSET 43
.node_map OUT 44
.node_map POK 41
.node_map FB 46
.node_map VCC 45
.node_map IN 38
.node_map EN 40
.node_map SW 39
.options
+ PSP_NPT=10001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 1m 0

.globalvar TEMP=25
.globalvar celera_i2c_frequency_KHz=1000

*Celera
.globalvar REF=0.9
.globalvar VIN=5
.globalvar tdext_khz=1000

C1 44 0 4.7u IC=0
C2 42 39 100n IC=2
C3 45 0 1u IC=0
V$IN 38 0 PWL NSEG=2 X0=0 Y0=0 X1=1u Y1=0 X2=2u Y2=20 
V$IN1 40 0 PWL NSEG=2 X0=0 Y0=0 X1=5u Y1=0 X2=5.00001u Y2={VIN} 
L1 39 44 4.7u
.PRINT V(#IN)
.GRAPH :#IN curveLabel= IN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe1  
.PRINT V(#EN)
.GRAPH :#EN curveLabel= EN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe2  
.PRINT V(#SW)
.GRAPH :#SW curveLabel= SW nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe3  
.PRINT I(L1#P)
.GRAPH L1#P curveLabel="I(L1-P)" nowarn=true analysis=tran|pop disabled=false 
.PRINT V(#OUT)
.GRAPH :#OUT curveLabel= OUT nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe5  
.PRINT V(#BST)
.GRAPH :#BST curveLabel= BST nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe6  
.PRINT V(#VCC)
.GRAPH :#VCC curveLabel= VCC nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe7  
.PRINT V(#FSET)
.GRAPH :#FSET curveLabel= FSET nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe8  
.PRINT V(#FB)
.GRAPH :#FB curveLabel= FB nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe9  
R1 39 44 1K
R2 43 0 53k
R3 44 46 800k
R4 46 0 200k
X$U1 0 celera vars: simulation_module='name' status='dev' simulation='typical'
X$WALTZ 38 0 40 35 41 43 36 45 37 0 46 0 38 WALTZ
