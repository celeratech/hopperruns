.GRAPH IN#P curveLabel="I(IN-pos)" nowarn=true analysis=tran|pop disabled=false 
.PRINT V(#EN)
.GRAPH :#EN curveLabel= EN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe2  
.PRINT V(#POK)
.GRAPH :#POK curveLabel= POK nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe3  
