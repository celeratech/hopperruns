CBST1 56 54 100n IC=2
COUT3 58 60 1u IC=0
CVCC 59 60 1u IC=0
V$EN 53 0 PWL NSEG=2 X0=0 Y0=0 X1=30u Y1=0 X2=30.001u Y2=0 
