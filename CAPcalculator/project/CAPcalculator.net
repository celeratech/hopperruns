.PRINT V(#porb)
.GRAPH :#porb curveLabel= porb nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe1  
.PRINT V(#fault_capcalculate)
.GRAPH :#fault_capcalculate curveLabel= fault_capcalculate nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe10  
.GRAPH "ComposeDigital('#meas_cap1', [0, 15],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=hex curveLabel="meas_cap1" disabled=false 
.PRINT ^meas_cap1$*
.PRINT V(#enable_balancer)
.GRAPH :#enable_balancer curveLabel= enable_balancer nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe13  
.PRINT V(#enable_shunt)
.GRAPH :#enable_shunt curveLabel= enable_shunt nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe14  
.GRAPH "ComposeDigital('#maximum_channel', [0, 1],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=dec curveLabel="maximum_channel" disabled=false 
.PRINT ^maximum_channel$*
.PRINT V(#clock)
.GRAPH :#clock curveLabel= clock nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe2  
.PRINT V(#enable_capcalculate)
.GRAPH :#enable_capcalculate curveLabel= enable_capcalculate nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe3  
.PRINT V(#mode_backup)
.GRAPH :#mode_backup curveLabel= mode_backup nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe4  
.PRINT V(#done_capcalulate)
.GRAPH :#done_capcalulate curveLabel= done_capcalulate nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe5  
.PRINT V(#shunt_registeractive)
.GRAPH :#shunt_registeractive curveLabel= shunt_registeractive nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe6  
.GRAPH "ComposeDigital('#meas_cap2', [0, 15],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=hex curveLabel="meas_cap2" disabled=false 
.PRINT ^meas_cap2$*
.GRAPH "ComposeDigital('#meas_cap3', [0, 15],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=hex curveLabel="meas_cap3" disabled=false 
.PRINT ^meas_cap3$*
.GRAPH "ComposeDigital('#meas_cap4', [0, 15],  '' , '%BUSNAME%$%WIRENUM%', [0.8, 0.9])*1.0+0" complete=true  axistype=digital   bus=hex curveLabel="meas_cap4" disabled=false 
.PRINT ^meas_cap4$*
