//**********************************************
//Layout Parameters
revision,layout,0p1
//LDO 

//New Ip 06192024

place IPOTT STONEldoOK 0 0 R0
place IPOTT STONEldoIBIASaccuracy 0 0 R0
place IPOTT STONEldoIBIAS 0 0 R0
place IPOTT STONEldoAMPLIFIER 0 0 R0
place IPOTT STONEldoAMPLIFIERconfiguration 0 0 R0
place IPOTT STONEldoOUTPUT 0 0 R0
place IPOTT STONEldoERRORsingle 0 0 R0
place IPOTT STONEldoERRORdual 0 0 R0
place IPOTT STONEldoFBreference 0 0 R0
place IPOTT STONEldoFBreferenceACCURACY 0 0 R0
placeIFELSE cellNameContains *configuration
//IF contains configuration
place IPOTT STONEldoENABLE 112.66 129.635 R0
place IPOTT STONEldoDFT 112.66 146.375 MX
placeELSE
//IFnot configuration  - place DFT and find a home for ENABLE
place IPOTT STONEldoDFT 113.03 129.635 R0
//and NOT configuration - ENABLE in config spot
placeTAPuntil
placeTAP 150 122
placeALTVIEW IPOTT STONEldoENABLE layout1 112.525 147.875 MX
//IFdual accuracy and Not configuration
placeTAP 180 12
place IPOTT STONEldoENABLE 171.66 7.84 R0
//IFsingle accuracy and NOT configuration
placeTAP 115 135
place IPOTT STONEldoENABLE 112.66 129.635 R0
placeTAPEND
placeEND
//placeIFELSE cellNameContains *reference
placeINST XPFET 248.28 130.71 MX
placeINST XNFET 248.28 130.71 MX






endlayoutbio
