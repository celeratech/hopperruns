*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map BST 39
.node_map OUT 40
.node_map VCC 36
.node_map OK 37
.node_map IN 42
.node_map EN 41
.node_map SW 38
.options
+ PSP_NPT=10001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
*.pop TRIG_GATE={TRIG_GATE} TRIG_COND=0_TO_1 MAX_PERIOD=1u CONVERGENCE=1p CYCLES_BEFORE_LAUNCH=5 TD_RUN_AFTER_POP_FAILS=-1
.tran 22m 0

.globalvar REF=1.0
.globalvar VIN=3.3
.globalvar tdext_khz=1000
.globalvar TEMP=25

X$AUG 36 39 42 38 0 40 37 41 0 42 AUGMENT
COUT4 36 0 100n IC=0
COUT5 40 0 10u IC=0
COUT6 39 38 100n IC=2
V$EN1 41 0 PWL NSEG=2 X0=0 Y0=0 X1=21u Y1=0 X2=21.001u Y2={VIN} 
IOUT1 40 0 PWL NSEG=4 X0=0 Y0=0 X1=2m Y1=0 X2=2.01m Y2=200m X3=2.5m Y3=200m X4=2.51m Y4=0 
.PRINT V(#BST)
.GRAPH :#BST axisType="auto" persistence=-1 curveLabel="BST" analysis="tran|pop" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe10  
.PRINT V(#SW)
.GRAPH :#SW curveLabel= SW nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe11  
.PRINT V(#OUT)
.GRAPH :#OUT axisType="auto" persistence=-1 curveLabel="OUT" analysis="tran|pop" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe12  
.PRINT I(VSYS1#N)
.GRAPH VSYS1#N axisType="auto" persistence=-1 curveLabel="AUG(IN)" analysis="tran|pop" xLog="auto" yLog="lin"  nowarn=true disabled=false 
.PRINT V(#VCC)
.GRAPH :#VCC axisType="auto" persistence=-1 curveLabel="VCC" analysis="tran|pop" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe14  
.PRINT V(#EN)
.GRAPH :#EN curveLabel= EN nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe15  
.PRINT V(#OK)
.GRAPH :#OK axisType="auto" persistence=-1 curveLabel="OK" analysis="tran|pop" xLog="auto" yLog="auto"  nowarn=true disabled=false PROBEREF=Probe16  
R2 40 37 100k
