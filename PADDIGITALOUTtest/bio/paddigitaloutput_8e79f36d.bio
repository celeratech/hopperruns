// *********************************************
//Layout Parameters
//Layout Parameters
revision,layout,0p1
layout,paddigitaloutput

placeIFELSE cellNameContains Nweak&&Pweak
place Generate STONEdftIN -57.11 0 R0
place Generate STONEpaddigitaloutputPREDRIVERdft -3.175 1.05 R0
place Generate STONEpaddigitaloutputPREDRIVER -11.29 8.58 MX
//dft or not
placeALTVIEW Generate STONEpaddigitaloutFLAG layout1row -2.54 23.93 R0
place Generate STONEpaddigitaloutputNweak -15.53 23.6 MX
place Generate STONEpaddigitaloutputPweak 40.225 23.69 R180
placeELSE
place Generate STONEdftIN -70.445 -0.29 R0
place Generate STONEpaddigitaloutFLAG 23.47 8.37 R0
place Generate STONEpaddigitaloutputPREDRIVERdft 23.47 0 R0
place Generate STONEpaddigitaloutputPREDRIVER 23.47 0 R0
//IN or not moves predriver on top
placeTAP 40 12
place Generate STONEpaddigitaloutputPREDRIVERdft -20.93 42.82 MX
place Generate STONEpaddigitaloutputPREDRIVERdft 23.47 0 R0
placeTAP 40 12
place Generate STONEpaddigitaloutputPREDRIVER -20.93 42.82 MX
place Generate STONEpaddigitaloutputPREDRIVER 23.47 0 R0
place Generate STONEpaddigitaloutputNstrong -6.245 0 R0
place Generate STONEpaddigitaloutputPstrong -5.245 0 MY
placeEND
placeIF cellNameContains dftOUT
place Generate STONEdftOUT -8.765 73.26 MX
place Generate STONEpaddigitaloutputNweak -3.27 6.655 R0
place Generate STONEpaddigitaloutputPweak -2.97 6.565 MY
placeALTVIEW Generate STONEpaddigitaloutputNstrong layoutSHORT 1 13.57 R180
placeALTVIEW Generate STONEpaddigitaloutputPstrong layoutSHORT 0 13.57 MX
place Generate STONEpd500 33.516 13.69 R0
place DFT DFTTDOdisableDFT -0.865 13.805 R0
placeALTVIEW Generate STONEpaddigitaloutFLAG layout1rowv2 -0.865 13.805 MY
placeTAP -28 14
place Generate STONEpaddigitaloutputPREDRIVER -43.075 13.805 R0
place Generate STONEpaddigitaloutputPREDRIVER 3.975 -2 MX
placeTAP -28 14
place Generate STONEpaddigitaloutputPREDRIVERdft -43.075 13.805 R0
place Generate STONEpaddigitaloutputPREDRIVERdft 3.975 -2 MX
placeEND
placeINST Xfilter -56.275 -2 MX

moveORIGIN y
placeINST Xpmos0 9.385 -17.73 R270
placeINST Xnmos0 -12 -23.7 MYR90

placeHVRING
placeROUTE
endlayoutbio
