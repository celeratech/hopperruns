X$V1 21 0 PUL_SOURCE vars: _V1=0 _V2=1 _FREQ=1Meg _DELAY=11u _DRATIOx100=50 _T_RISE=1n _T_FALL=1n _DAMP_COEF=0 _PWIDTH=499n _OFF_UNTIL_DELAY=1 _IDLE_IN_POP=0 _USEPHASE=0 _PHASE=11u
V15 22 0 PWL NSEG=4 X0=0 Y0=0 X1=50u Y1=0 X2=50.001u Y2={VIN} X3=250u Y3={VIN} X4=250.001u Y4=0 
V2 23 0 PWL NSEG=2 X0=0 Y0=0 X1=100u Y1=0 X2=100.001u Y2={VIN} 
V3 25 0 PWL NSEG=2 X0=0 Y0=0 X1=1u Y1=0 X2=2u Y2={REF} 
V4 24 0 PWL NSEG=2 X0=0 Y0=0 X1=1u Y1=0 X2=2u Y2={VIN} 
V5 29 0 PWL NSEG=2 X0=0 Y0=0 X1=10u Y1=0 X2=20u Y2=0 
