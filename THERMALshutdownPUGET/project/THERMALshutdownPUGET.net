* Z:\celera\projects\Simplis\playcalum\Puget\Puget0\301E\verification\sim_THERMALshutdown.sxsch
*#SIMETRIX
X$CV 12 celera vars: simulation_module='name' status='dev' simulation='typical'

.node_map SIMPV 24
.node_map thermal_shutdown 28
.node_map REF 25
.node_map clock 27
.node_map fault_charger 30
.node_map enable 26
.node_map GND 29
.options
+ PSP_NPT=50001
+ POP_ITRMAX=20
+ POP_OUTPUT_CYCLES=5
+ SNAPSHOT_INTVL=0
+ SNAPSHOT_NPT=11
+ MIN_AVG_TOPOLOGY_DUR=1a
+ AVG_TOPOLOGY_DUR_MEASUREMENT_WINDOW=128
.tran 300u 0

.globalvar TEMP=25
.globalvar VIN = 5.0
.globalvar REF = 1.2
.globalvar tdext_khz=10
.globalvar CAP1=3.2
.globalvar CAP2=3.3
.globalvar CAP3=3.4
.globalvar CAP4=3.5

.PRINT V(#enable)
.GRAPH :#enable curveLabel= enable nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe1  
.PRINT V(#thermal_shutdown)
.GRAPH :#thermal_shutdown curveLabel= thermal_shutdown nowarn=true ylog=auto xlog=auto analysis=tran|pop disabled=false PROBEREF=Probe3  
X$THERMAL 24 25 26 28 THERMALshutdownPUGET
